{
    "title": "eBay Marketplace Analyzer Input",
    "description": "Search and extract product data from eBay",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "search_query": {
            "title": "Search Query",
            "type": "string",
            "description": "Keywords to search for on eBay",
            "example": "vintage camera",
            "prefill": "",
            "editor": "textfield"
        },
        "category": {
            "title": "Category",
            "type": "string",
            "description": "eBay category to search in",
            "default": "all",
            "enum": ["all", "electronics", "fashion", "home", "sporting_goods", "toys", "collectibles", "books", "automotive"],
            "enumTitles": ["All Categories", "Electronics", "Fashion", "Home & Garden", "Sporting Goods", "Toys & Hobbies", "Collectibles", "Books", "Automotive"],
            "editor": "select"
        },
        "condition": {
            "title": "Item Condition",
            "type": "string",
            "description": "Filter by item condition",
            "default": "all",
            "enum": ["all", "new", "used", "refurbished", "for_parts"],
            "enumTitles": ["All Conditions", "New", "Used", "Refurbished", "For Parts or Not Working"],
            "editor": "select"
        },
        "listing_type": {
            "title": "Listing Type",
            "type": "string",
            "description": "Type of listings to include",
            "default": "all",
            "enum": ["all", "buy_it_now", "auction", "best_offer"],
            "enumTitles": ["All Types", "Buy It Now", "Auction", "Best Offer"],
            "editor": "select"
        },
        "min_price": {
            "title": "Minimum Price",
            "type": "number",
            "description": "Minimum price in USD",
            "minimum": 0,
            "editor": "number",
            "sectionCaption": "Price Filters",
            "sectionDescription": "Filter by price range"
        },
        "max_price": {
            "title": "Maximum Price",
            "type": "number",
            "description": "Maximum price in USD",
            "minimum": 0,
            "editor": "number"
        },
        "free_shipping": {
            "title": "Free Shipping Only",
            "type": "boolean",
            "description": "Only show items with free shipping",
            "default": false,
            "editor": "checkbox",
            "sectionCaption": "Shipping Options",
            "sectionDescription": "Configure shipping filters"
        },
        "location": {
            "title": "Item Location",
            "type": "string",
            "description": "Filter by seller location",
            "default": "worldwide",
            "enum": ["worldwide", "us_only", "north_america", "europe", "asia"],
            "enumTitles": ["Worldwide", "US Only", "North America", "Europe", "Asia"],
            "editor": "select"
        },
        "sort_by": {
            "title": "Sort By",
            "type": "string",
            "description": "How to sort the results",
            "default": "best_match",
            "enum": ["best_match", "price_low_high", "price_high_low", "ending_soonest", "newly_listed"],
            "enumTitles": ["Best Match", "Price: Low to High", "Price: High to Low", "Ending Soonest", "Newly Listed"],
            "editor": "select"
        },
        "include_sold": {
            "title": "Include Sold Listings",
            "type": "boolean",
            "description": "Include completed/sold listings for market research",
            "default": false,
            "editor": "checkbox",
            "sectionCaption": "Market Research",
            "sectionDescription": "Options for market analysis"
        },
        "max_items": {
            "title": "Maximum Items",
            "type": "integer",
            "description": "Maximum number of items to scrape",
            "default": 100,
            "minimum": 1,
            "maximum": 1000,
            "editor": "number"
        },
        "output_format": {
            "title": "Output Format",
            "type": "string",
            "description": "Format for the output data",
            "default": "json",
            "enum": ["json", "csv", "excel"],
            "enumTitles": ["JSON", "CSV", "Excel"],
            "editor": "select",
            "sectionCaption": "Output Settings",
            "sectionDescription": "Configure output format"
        }
    },
    "required": ["search_query"]
}